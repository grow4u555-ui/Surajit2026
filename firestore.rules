rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'james.disusa123@gmail.com'
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Entity Validation Blueprints ---
    function isValidProduct(data) {
      return data.keys().hasAll([
          'id', 'name', 'slug', 'description', 'category', 'price',
          'images', 'colorVariations', 'stockQuantity', 'sku',
          'featured', 'bestSeller', 'newArrival', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'slug', 'description', 'category', 'price',
          'discountPrice', 'images', 'colorVariations', 'stockQuantity',
          'sku', 'featured', 'bestSeller', 'newArrival', 'materials',
          'dimensions', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 140
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 160
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 4000
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.price is number && data.price >= 0 && data.price <= 10000000
        && (!('discountPrice' in data) || data.discountPrice == null || (data.discountPrice is number && data.discountPrice >= 0 && data.discountPrice <= data.price))
        && data.images is list && data.images.size() >= 1 && data.images.size() <= 12
        && data.images[0] is string && data.images[0].size() >= 1 && data.images[0].size() <= 1200
        && data.colorVariations is list && data.colorVariations.size() <= 10
        && (data.colorVariations.size() == 0 || (
          data.colorVariations[0] is map
          && data.colorVariations[0].keys().hasAll(['name', 'hex', 'images', 'stock'])
          && data.colorVariations[0].name is string && data.colorVariations[0].name.size() <= 80
          && data.colorVariations[0].hex is string && data.colorVariations[0].hex.size() <= 16
          && data.colorVariations[0].images is list && data.colorVariations[0].images.size() <= 12
          && data.colorVariations[0].stock is int && data.colorVariations[0].stock >= 0
        ))
        && data.stockQuantity is int && data.stockQuantity >= 0 && data.stockQuantity <= 1000000
        && data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 64
        && data.featured is bool
        && data.bestSeller is bool
        && data.newArrival is bool
        && (!('materials' in data) || data.materials == null || (data.materials is string && data.materials.size() <= 300))
        && (!('dimensions' in data) || data.dimensions == null || (data.dimensions is string && data.dimensions.size() <= 200))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'displayOrder', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'slug', 'description', 'imageUrl', 'displayOrder', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 100
        && (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 500))
        && (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 1200))
        && data.displayOrder is int && data.displayOrder >= 0 && data.displayOrder <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'id', 'orderNumber', 'userId', 'customerName', 'customerEmail',
          'customerPhone', 'shippingAddress', 'items', 'subtotal',
          'shippingCost', 'discountTotal', 'totalAmount', 'paymentMethod',
          'paymentStatus', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'orderNumber', 'userId', 'customerName', 'customerEmail',
          'customerPhone', 'shippingAddress', 'items', 'subtotal',
          'shippingCost', 'discountTotal', 'totalAmount', 'paymentMethod',
          'paymentStatus', 'razorpayOrderId', 'razorpayPaymentId',
          'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 40
        && isValidId(data.userId)
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120
        && data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 180
        && data.customerPhone is string && data.customerPhone.size() >= 6 && data.customerPhone.size() <= 24
        && data.shippingAddress is map
        && data.shippingAddress.keys().hasAll(['line1', 'city', 'state', 'pinCode'])
        && data.shippingAddress.keys().hasOnly(['line1', 'line2', 'city', 'state', 'pinCode', 'country'])
        && data.shippingAddress.line1 is string && data.shippingAddress.line1.size() >= 1 && data.shippingAddress.line1.size() <= 240
        && (!('line2' in data.shippingAddress) || data.shippingAddress.line2 == null || (data.shippingAddress.line2 is string && data.shippingAddress.line2.size() <= 240))
        && data.shippingAddress.city is string && data.shippingAddress.city.size() >= 1 && data.shippingAddress.city.size() <= 100
        && data.shippingAddress.state is string && data.shippingAddress.state.size() >= 1 && data.shippingAddress.state.size() <= 100
        && data.shippingAddress.pinCode is string && data.shippingAddress.pinCode.size() >= 4 && data.shippingAddress.pinCode.size() <= 16
        && (!('country' in data.shippingAddress) || data.shippingAddress.country == null || (data.shippingAddress.country is string && data.shippingAddress.country.size() <= 80))
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50
        && data.items[0] is map
        && data.items[0].keys().hasAll(['productId', 'name', 'selectedColor', 'quantity', 'unitPrice', 'image'])
        && data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 50000000
        && data.shippingCost is number && data.shippingCost >= 0 && data.shippingCost <= 100000
        && data.discountTotal is number && data.discountTotal >= 0 && data.discountTotal <= 50000000
        && data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 50000000
        && data.paymentMethod in ['COD', 'RAZORPAY']
        && data.paymentStatus in ['Pending', 'Paid', 'Failed', 'Refunded']
        && (!('razorpayOrderId' in data) || data.razorpayOrderId == null || (data.razorpayOrderId is string && data.razorpayOrderId.size() <= 120))
        && (!('razorpayPaymentId' in data) || data.razorpayPaymentId == null || (data.razorpayPaymentId is string && data.razorpayPaymentId.size() <= 120))
        && data.status in ['Pending', 'Confirmed', 'Processing', 'Shipped', 'Delivered', 'Cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'address', 'role', 'createdAt', 'updatedAt'])
        && isValidId(data.uid) && data.uid == userId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 180
        && (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 24))
        && (!('address' in data) || data.address == null || data.address is map)
        && data.role in ['customer', 'admin']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCartItem(data) {
      return data.keys().hasAll(['id', 'productId', 'selectedColor', 'quantity', 'updatedAt'])
        && data.keys().hasOnly(['id', 'productId', 'selectedColor', 'quantity', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.productId)
        && data.selectedColor is string && data.selectedColor.size() >= 1 && data.selectedColor.size() <= 80
        && data.quantity is int && data.quantity >= 1 && data.quantity <= 99
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'grantedAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedAt'])
        && isValidId(data.uid) && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 180
        && data.grantedAt is timestamp;
    }

    function isValidStoreSettings(data) {
      return data.keys().hasAll(['id', 'storeName', 'contactEmail', 'shippingFee', 'freeShippingThreshold', 'currencySymbol', 'updatedAt'])
        && data.keys().hasOnly(['id', 'storeName', 'tagline', 'contactEmail', 'contactPhone', 'studioAddress', 'shippingFee', 'freeShippingThreshold', 'currencySymbol', 'updatedAt'])
        && isValidId(data.id)
        && data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 100
        && (!('tagline' in data) || data.tagline == null || (data.tagline is string && data.tagline.size() <= 240))
        && data.contactEmail is string && data.contactEmail.size() >= 3 && data.contactEmail.size() <= 180
        && (!('contactPhone' in data) || data.contactPhone == null || (data.contactPhone is string && data.contactPhone.size() <= 32))
        && (!('studioAddress' in data) || data.studioAddress == null || (data.studioAddress is string && data.studioAddress.size() <= 300))
        && data.shippingFee is number && data.shippingFee >= 0 && data.shippingFee <= 50000
        && data.freeShippingThreshold is number && data.freeShippingThreshold >= 0 && data.freeShippingThreshold <= 1000000
        && data.currencySymbol is string && data.currencySymbol.size() >= 1 && data.currencySymbol.size() <= 8
        && data.updatedAt is timestamp;
    }

    function isValidSubscriber(data) {
      return data.keys().hasAll(['id', 'email', 'createdAt'])
        && data.keys().hasOnly(['id', 'email', 'createdAt'])
        && isValidId(data.id)
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 180
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;

      allow create: if isAdmin()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().id == productId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            incoming().diff(existing()).affectedKeys().hasOnly(['stockQuantity', 'colorVariations', 'updatedAt'])
            && incoming().stockQuantity < existing().stockQuantity
            && incoming().stockQuantity >= 0
          )
        );

      allow delete: if isAdmin() && isValidId(productId);
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;

      allow create: if isAdmin()
        && isValidId(categoryId)
        && isValidCategory(incoming())
        && incoming().id == categoryId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(categoryId)
        && isValidCategory(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(categoryId);
    }

    match /orders/{orderId} {
      allow get: if isVerified() && isValidId(orderId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isVerified()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().id == orderId
        && incoming().userId == request.auth.uid
        && incoming().status == 'Pending'
        && (
          (incoming().paymentMethod == 'COD' && incoming().paymentStatus == 'Pending')
          || (incoming().paymentMethod == 'RAZORPAY' && incoming().paymentStatus == 'Paid' && 'razorpayPaymentId' in incoming() && incoming().razorpayPaymentId is string && incoming().razorpayPaymentId.size() >= 6)
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().userId == request.auth.uid
            && existing().status == 'Pending'
            && incoming().status == 'Cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().role == 'customer'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'address', 'updatedAt'])
          )
        );

      allow delete: if isAdmin() && isValidId(userId);

      match /cart/{itemId} {
        allow get: if isValidId(userId) && isValidId(itemId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);

        allow create: if isValidId(userId)
          && isValidId(itemId)
          && isOwner(userId)
          && isValidCartItem(incoming())
          && incoming().id == itemId
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/products/$(incoming().productId));

        allow update: if isValidId(userId)
          && isValidId(itemId)
          && isOwner(userId)
          && isValidCartItem(incoming())
          && incoming().id == existing().id
          && incoming().productId == existing().productId
          && incoming().updatedAt == request.time;

        allow delete: if isValidId(userId) && isValidId(itemId) && isOwner(userId);
      }
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(userId) && isValidAdminRecord(incoming(), userId) && incoming().grantedAt == request.time;
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /storeSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update: if isAdmin()
        && isValidId(settingId)
        && isValidStoreSettings(incoming())
        && incoming().id == settingId
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /newsletterSubscribers/{subscriberId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(subscriberId)
        && isValidSubscriber(incoming())
        && incoming().id == subscriberId
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(subscriberId);
    }
  }
}
